{
  "manifest_version": 3,
  "name": "AutonomousHire Autofill",
  "version": "0.2.2",
  "description": "Fills job application forms from your AutonomousHire profile, in your own logged-in browser. You review, solve any CAPTCHA, and submit.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "dashboard_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutonomousHire Autofill"
  }
}
