# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth2 (run: python tools/google_auth_setup.py to generate tokens)
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
GMAIL_REFRESH_TOKEN=...
GOOGLE_CALENDAR_ID=primary

# LinkedIn session cookies (legacy — no longer required; persistent profile handles login)
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# LinkedIn automation settings
LI_PROFILE_DIR=./data/chrome_profile   # Playwright persistent profile directory
LI_PAUSE=false                          # Kill switch: set true to halt all LinkedIn activity
LI_ACTIVE_HOURS_START=8                 # Hour (0-23) when LinkedIn automation starts
LI_ACTIVE_HOURS_END=21                  # Hour (0-23) when LinkedIn automation stops

# Discord notifications (optional — review queue alerts and daily digests)
DISCORD_WEBHOOK_REVIEW=                 # Paste webhook URL for action alerts
DISCORD_WEBHOOK_DIGEST=                 # Paste webhook URL for daily summary

# Human-in-the-loop gates (set false to auto-proceed without approval)
HUMAN_IN_LOOP_NEW_ATS=true              # Pause before submitting to an ATS never seen before
HUMAN_IN_LOOP_LOW_CONF=true            # Pause when fit score is borderline (65-72)
HUMAN_IN_LOOP_HIGH_VALUE=true           # Pause before messaging senior contacts (VP+)

# Search
TAVILY_API_KEY=tvly-...

# Vector DB
CHROMA_PERSIST_DIR=./data/chroma_db
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=autonomoushire

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
DASHBOARD_PORT=8501
APPROVAL_WEBHOOK_URL=

# local path to the résumé the vendor blast attaches (never commit the file)
VENDOR_RESUME_PATH=/absolute/path/to/resume.pdf
